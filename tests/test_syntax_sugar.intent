// S2a: 语法糖补全 — 切片(海象 := + 切片赋值)
// 本切片范围: ① 海象赋值表达式 ② 切片赋值(步长限1, 右侧限列表, 增删长度)
// 剩余(断点已记, 后续轮次): 星号解包 / 位置 only / match 类模式+守卫

// ── 海象 := ──

def test_walrus_binds_and_returns_value() {
    let a = (n := 5);
    assert a == 5, "海象返回被赋的值";
    assert n == 5, "海象把名绑进当前作用域";
}

def test_walrus_reassign_existing() {
    let mut count = 0;
    count := count + 1;      // 已存在 → 赋值语义
    count := count + 1;
    assert count == 2, "海象对已存在变量走赋值";
}

def test_walrus_lowest_precedence() {
    let b = (m := 2 > 1);    // m := (2 > 1) — 低于比较运算
    assert b == true, "海象右部吃掉完整比较表达式";
    assert m == true, "绑定的是比较结果";
    let c = (k := true or false);   // 低于 or(本语言 or 返回 Bool, 非 Python 的返回值语义)
    assert c == true and k == true, "海象低于逻辑或";
}

def test_walrus_in_while_condition() {
    // 经典场景: 条件里消费并暂存(无海象就要在块内重复调用)
    let mut log = [];
    let mut i = 0;
    def produce(): Int {
        i := i + 1;
        return i;
    }
    while ((v := produce()) <= 3) {
        push(log, v);
    }
    assert len(log) == 3, "while 条件里海象消费三次";
    assert v == 4, "条件最终值为 4(<=3 不成立那次)";
}

def test_walrus_nested_scope_isolated() {
    let outer = (x := 1);
    def inner() {
        let inner_v = (y := 2);
        return inner_v + y;
    }
    assert inner() == 4, "函数内海象绑在函数作用域";
    assert outer == 1 and x == 1, "外层海象不受内层影响";
}

// ── 切片赋值 ──

def test_slice_assign_replace_same_length() {
    let mut l = [1, 2, 3, 4, 5];
    l[1:3] = [20, 30];
    assert l == [1, 20, 30, 4, 5], "等长替换";
}

def test_slice_assign_grow() {
    let mut l = [1, 2, 3];
    l[1:2] = [20, 21, 22];
    assert l == [1, 20, 21, 22, 3], "切片赋值可增长列表";
}

def test_slice_assign_shrink() {
    let mut l = [1, 2, 3, 4, 5];
    l[1:4] = [9];
    assert l == [1, 9, 5], "切片赋值可收缩列表";
}

def test_slice_assign_open_bounds() {
    let mut l = [1, 2, 3, 4, 5];
    l[:2] = [10, 11];        // 省头
    assert l == [10, 11, 3, 4, 5], "省头切片赋值";
    l[3:] = [40, 50];        // 省尾
    assert l == [10, 11, 3, 40, 50], "省尾切片赋值";
    l[:] = [7];              // 全切片
    assert l == [7], "全切片赋值整体替换";
}

def test_slice_assign_negative_bounds() {
    let mut l = [1, 2, 3, 4, 5];
    l[-2:] = [99];
    assert l == [1, 2, 3, 99], "负索引切片赋值(Python 语义)";
}

def test_slice_read_still_works() {
    // 回归: 切片读取路径不受赋值改动影响
    let l = [1, 2, 3, 4, 5];
    assert l[1:3] == [2, 3], "切片读取: 区间";
    assert l[:2] == [1, 2], "切片读取: 省头";
    assert l[3:] == [4, 5], "切片读取: 省尾";
    assert l[:] == [1, 2, 3, 4, 5], "切片读取: 全量";
    assert l[::2] == [1, 3, 5], "切片读取: 步长";
    assert l[-2:] == [4, 5], "切片读取: 负索引";
}

def test_slice_assign_errors() {
    let mut l = [1, 2, 3, 4, 5];
    // 右侧非列表 — 显式拒绝
    let e1 = expect_error(fn() {
        l[1:2] = 99;
    }, "TypeError");
    assert e1.type == "TypeError", "切片赋值右侧必须是列表";
    // 扩展切片(步长≠1) — 显式拒绝
    let e2 = expect_error(fn() {
        l[::2] = [1, 2, 3];
    }, "TypeError");
    assert e2.type == "TypeError", "扩展切片赋值未实现, 显式拒绝";
    // 复合操作符 — 显式拒绝
    let e3 = expect_error(fn() {
        l[1:2] += [9];
    }, "RuntimeError");
    assert e3.type == "RuntimeError", "切片赋值不支持复合操作符";
    // 字符串目标 — 显式拒绝
    let e4 = expect_error(fn() {
        let mut s = "hello";
        s[1:2] = "x";
    }, "TypeError");
    assert e4.type == "TypeError", "字符串不可切片赋值";
}
