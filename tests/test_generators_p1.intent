// 生成器回归测试(P1.5) — yield 与 yield from 委派

def test_yield_basic() {
    def gen() {
        yield 1;
        yield 2;
        yield 3;
    };
    let r = gen();
    assert len(r) == 3, "yield 收集三个值";
    assert r[0] == 1, "yield 顺序";
};

def test_yield_from_list() {
    def inner() {
        yield from [10, 20, 30];
    };
    let r = inner();
    assert len(r) == 3, "yield from 列表";
    assert r[1] == 20, "yield from 转发值";
};

def test_yield_from_generator() {
    // 委派链: 外层生成器转发内层生成器的产出
    def base() {
        yield 1;
        yield 2;
    };
    def wrapper() {
        yield 0;
        yield from base();
        yield 3;
    };
    let r = wrapper();
    assert len(r) == 4, "yield from 生成器委派";
    assert r[2] == 2, "委派值正确嵌入";
};

def test_yield_from_dict() {
    def keys_gen() {
        yield from {"a": 1, "b": 2};
    };
    let r = keys_gen();
    assert len(r) == 2, "yield from 字典转发键";
};

def test_yield_mixed() {
    def mixed() {
        yield "start";
        yield from [1, 2];
        yield "end";
    };
    let r = mixed();
    assert len(r) == 4, "yield 与 yield from 混用";
    assert r[0] == "start", "混用顺序";
    assert r[3] == "end", "混用收尾";
};
