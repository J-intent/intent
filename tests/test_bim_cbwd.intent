// CBWD 移植回归测试（BD4 最小切片：洞口合并）
// 算法源: D:\Desktop\CBWD\COM.py find_merge_groups(连通分量+空间哈希预筛)
// 对照基准: tools/cbwd_reference.py(COM.py 纯算法提取) — 签名逐例一致
// 单位: mm(COM.py 原 ft 几何, 边界换算; 算法内无 304.8 魔法数)

import std.bim.cbwd;

// 矩形洞口助手(测试数据构造)
def rect(x: Float, y: Float, z: Float) {
    let h = 50.0;
    return {"min": [x - h, y - h, z - h], "max": [x + h, y + h, z + h],
            "cylindrical": false, "radius": 0.0, "center": [x, y, z]};
};

// 圆柱洞口助手
def cyl(x: Float, y: Float, z: Float, r: Float) {
    return {"min": [x - r, y - r, z - r], "max": [x + r, y + r, z + r],
            "cylindrical": true, "radius": r, "center": [x, y, z]};
};

def test_bbox_gap_metric() {
    let a = rect(0.0, 0.0, 0.0);
    let b = rect(200.0, 0.0, 0.0);
    assert abs(bbox_gap_mm(a, b) - 100.0) < 0.000001, "x 向间隙 = 200-100 = 100mm";
    assert bbox_gap_mm(a, a) == 0.0, "自间隙为 0";
};

def test_merge_boundary_equal() {
    // gap == max_distance 时合并(参考语义: 只有 gap > D 才拒)
    let chain = [rect(0.0, 0.0, 0.0), rect(200.0, 0.0, 0.0), rect(400.0, 0.0, 0.0)];
    assert groups_signature(find_merge_groups(chain, 100.0)) == ["0-1-2"],
        "D=100: gap==D 传递链合并";
    assert groups_signature(find_merge_groups(chain, 99.0)) == ["0", "1", "2"],
        "D=99: 传递链断裂各自为组";
};

def test_merge_transitive() {
    let chain = [rect(0.0, 0.0, 0.0), rect(200.0, 0.0, 0.0), rect(400.0, 0.0, 0.0)];
    assert groups_signature(find_merge_groups(chain, 150.0)) == ["0-1-2"],
        "D=150: A-B B-C 均可合 → 传递为一组(连通分量语义)";
};

def test_cylindrical_surface_gap() {
    // bbox 间隙 197 ≤ D=200, 但中心距 223.6 - (r1+r2)=203.6 > 200 → 不合并
    let c1 = cyl(0.0, 0.0, 0.0, 10.0);
    let c2 = cyl(200.0, 100.0, 0.0, 10.0);
    assert groups_signature(find_merge_groups([c1, c2], 200.0)) == ["0", "1"],
        "圆柱精修: 表面间隙超限, bbox 近也不合";
    assert groups_signature(find_merge_groups([c1, c2], 210.0)) == ["0-1"],
        "圆柱精修: D=210 表面间隙也过 → 合";
};

def test_edge_cases() {
    assert len(find_merge_groups([], 150.0)) == 1, "空表 → 1 个空组(参考语义)";
    assert len(find_merge_groups([rect(0.0, 0.0, 0.0)], 150.0)) == 1,
        "单元素 → 整体一组";
};

def test_prefilter_equals_slow_path() {
    // 空间哈希预筛与 O(n²) 全比较必须给出同一分组(不漏不重)
    let chain = [rect(0.0, 0.0, 0.0), rect(200.0, 0.0, 0.0), rect(400.0, 0.0, 0.0)];
    let fast_chain = groups_signature(find_merge_groups(chain, 150.0));
    let slow_chain = groups_signature(find_merge_groups_slow(chain, 150.0));
    assert fast_chain == slow_chain,
        "预筛路径 == 慢路径(小样)";
    let c1 = cyl(0.0, 0.0, 0.0, 10.0);
    let c2 = cyl(200.0, 100.0, 0.0, 10.0);
    let fast_cyl = groups_signature(find_merge_groups([c1, c2], 200.0));
    let slow_cyl = groups_signature(find_merge_groups_slow([c1, c2], 200.0));
    assert fast_cyl == slow_cyl,
        "预筛路径 == 慢路径(圆柱)";
};

