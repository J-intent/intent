// 控制流回归测试 — if/while/for
def test_if_statement() {
    let mut r = 0;
    if 5 > 3 { r = 1; };
    assert r == 1, "if 真分支";
    if 2 > 9 { r = 99; };
    assert r == 1, "if 假分支不执行";
};

def test_while_loop() {
    let mut i = 0;
    let mut sum = 0;
    while i < 5 {
        sum = sum + i;
        i = i + 1;
    };
    assert sum == 10, "while 累加 0..4";
};

def test_for_range() {
    let mut sum = 0;
    for i in range(5) {
        sum = sum + i;
    };
    assert sum == 10, "for range 累加";
};

def test_for_dict() {
    let d = {"a": 1, "b": 2};
    let mut total = 0;
    for k in d {
        total = total + d[k];
    };
    assert total == 3, "for 遍历字典";
};

def test_else_if_chain() {
    // else if 链回归(解析器修复: 原 else 后只接受 '{', else if 触发 panic 错位)
    let mut r = 0;
    let n = 2;
    if n == 1 {
        r = 1;
    } else if n == 2 {
        r = 2;
    } else if n == 3 {
        r = 3;
    } else {
        r = 4;
    }
    assert r == 2, "else if 命中中段";
    let m = 9;
    let mut r2 = 0;
    if m == 1 {
        r2 = 1;
    } else if m == 2 {
        r2 = 2;
    } else {
        r2 = 4;
    }
    assert r2 == 4, "else if 落 else";
};

def test_else_if_nested_in_loop() {
    // else if 在循环体内的组合(模块加载错位事故的回归形态)
    let mut hits = 0;
    let mut i = 0;
    while i < 6 {
        if i == 0 {
            hits = hits + 1;
        } else if i == 3 {
            hits = hits + 10;
        } else {
            hits = hits + 100;
        }
        i = i + 1;
    }
    assert hits == 411, "循环内 else if 链(1 + 10 + 4*100)";
};
