// Intent 语言演示 — 心学为体，禅道为翼，马哲为用
// 只用真实存在的特性(v2.0)

// ── 1. let = 如如不动 ──
let name = "Intent";
let version = "2.0";
print("语言: ", name, " v", version);

// ── 2. let mut = 承认我在改变 ──
let mut counter = 0;
counter = counter + 1;
counter = counter + 1;
print("计数器: ", counter);

// ── 3. 闭包 = 此心光明 ──
def make_adder(n: Int) {
    return fn(x: Int) { return x + n; };
};
let add5 = make_adder(5);
print("add5(10) = ", add5(10));

// ── 4. 管道 = 知行合一 ──
def double(x: Int): Int { return x * 2; };
def inc(x: Int): Int { return x + 1; };
print("5 |> double |> inc = ", 5 |> double |> inc);

// ── 5. match = 格物致知 ──
def kind(n: Int): String {
    return match n {
        x if x > 0 => "正数",
        x if x < 0 => "负数",
        _ => "零",
    };
};
print("kind(-3) = ", kind(-3));

// ── 6. Result + ? = 烦恼即菩提 ──
def safe_div(a: Int, b: Int) {
    if b == 0 { return Err("除数不能为零"); };
    return Ok(a / b);
};
let r = safe_div(22, 7)?;
print("22 / 7 = ", r);

// ── 7. 契约 = 实事求是 ──
def withdraw(balance: Int, amount: Int): Int
    requires amount > 0
    requires balance >= amount
    ensures result >= 0
{
    return balance - amount;
};
print("取款 100-30 = ", withdraw(100, 30));

// ── 8. with = 向死而生 ──
class Logger {
    def init() { this.lines = 0; }
    def log(msg: String) { this.lines = this.lines + 1; }
    def close() { print("Logger 关闭, 共 ", this.lines, " 行"); }
}
with Logger() as logger {
    logger.log("第一行");
    logger.log("第二行");
};

print("演示完成 — 存在先于本质");
