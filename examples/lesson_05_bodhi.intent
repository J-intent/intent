// ═══════════════════════════════════════════════════════════
// 第5课：烦恼即菩提 — 错误是另一种正常
// 哲学：禅宗"烦恼即菩提"、斯多葛"控制你能控制的"
// 语法：Result<T,E> + ? 操作符 + try/catch
//
// 心法：错误不是异常需要恐慌地捕获，
// 错误就是另一种返回值。Ok 和 Err 是平等的。
// ═══════════════════════════════════════════════════════════

print("════════════════════════════════════");
print("  第5课：烦恼即菩提");
print("  错误是另一种正常值");
print("════════════════════════════════════");
print("");

// ── 体验1：传统的恐慌 ──
print("【体验1】传统编程 = 对异常的恐慌");
print("  你 try { } catch(e) { } 包裹一切");
print("  你永远不知道哪里会炸");
print("  你的代码像走在雷区");
print("");

// ── 体验2：Result = 错误也是一种值 ──
print("【体验2】Result<T,E> = 错误也是一种返回值");
print("  Ok(value) 和 Err(reason) 是平等的");
print("  不存在正常路径和异常路径的二分");
print("  就像白天和黑夜，都是天空的自然状态");
print("");

// ── 体验3：? = 平静地传播 ──
print("【体验3】? 操作符 = 平静地传播");
print("  遇到 Err 时，不恐慌，不崩溃");
print("  让它自然地回流到调用者");
print("  就像溪水遇到石头——绕过去继续流");
print("");

// ── 体验4：try/catch = 最后的安全网 ──
print("【体验4】try/catch = 把烦恼转化为智慧");
try {
    let x = 1 / 0;
    print("  这行不会执行");
} catch e {
    print("  捕获到了错误！");
    print("  你看到了错误，你理解了它");
    print("  你不是被错误打败了——你认识了它");
};
print("");

// ── 体验5：finally = 无论如何 ──
let mut flag = 0;
try {
    flag = 1;
    let y = 1 / 0;
} catch e {
    flag = 2;
} finally {
    print("【体验5】finally = 无论如何，善始善终");
    print("  flag 最终 = ", flag);
    print("  无论成功失败，清理代码都会执行");
    print("  就像人生——无论结局如何，你都要走完");
};
print("");

// ── 体验6：错误恢复 = 受伤后继续走 ──
let mut try_count = 0;
let mut error_count = 0;
while try_count < 5 {
    try_count = try_count + 1;
    try {
        if try_count == 3 {
            let z = 1 / 0;
        };
        print("  第", try_count, "次尝试：成功");
    } catch e {
        error_count = error_count + 1;
        print("  第", try_count, "次尝试：失败（但继续）");
    };
};
print("");
print("【体验6】try in a loop = 受伤后继续走");
print("  尝试 ", try_count, " 次，失败 ", error_count, " 次");
print("  每一次失败都是一次认识");
print("  禅宗说：烦恼就是菩提");
print("  斯多葛说：控制你能控制的");

print("");
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
print("  第5课完成");
print("  心法：烦恼不是要消灭的东西，是要认识的");
print("  进阶：想想你上次 debug 时发现的 bug——");
print("        它不是错误，是你的代码在告诉你一件事");
