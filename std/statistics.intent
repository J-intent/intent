// std/statistics.intent — 统计度量(SL1, 纯 Intent 实现)
// 心学为体：平均数是一群数的公约数——众望所归的那个心
// 禅道为翼：方差度量的是离散的尘劳
// 马哲为用：mean/median/variance/stdev，无内置依赖，契约封门
//
// 语义与 Python statistics 对齐（总体方差，n 为分母）；
// 样本方差(n-1)留待真实需求，反膨胀不做。

export mean, median, variance, stdev;

// mean(lst: List) → Float  算术平均(空表违约)
def mean(lst) -> Float
    requires len(lst) > 0
{
    return sum(lst) / len(lst);
}

// median(lst: List) → Float  中位数(偶数取中间两值的平均)
def median(lst) -> Float
    requires len(lst) > 0
{
    let s = sorted(lst);
    let n = len(s);
    let mid = int(n / 2);
    if n % 2 == 1 {
        return s[mid];
    }
    return (s[mid - 1] + s[mid]) / 2;
}

// variance(lst: List) → Float  总体方差(均方偏离)
def variance(lst) -> Float
    requires len(lst) > 0
{
    let m = mean(lst);
    let mut acc = 0;
    for x in lst {
        acc = acc + (x - m) * (x - m);
    }
    return acc / len(lst);
}

// stdev(lst: List) → Float  总体标准差(方差的平方根)
def stdev(lst) -> Float
    requires len(lst) > 0
{
    return sqrt(variance(lst));
}
