// std/secrets.intent — 安全随机(SL1)
// 心学为体：真随机是世界不给答案的部分——令牌的尊严在于不可预测
// 禅道为翼：不可预测故可信，如缘起无常
// 马哲为用：secrets_* 内置支撑（Python secrets 语义，CSPRNG backing）
//
// 与 std/random 的分工：random 是可复现的伪随机（实验/模拟），
// secrets 是密码学安全随机（令牌/口令/密钥）。

export token_hex, rand_below, choice;

// token_hex(n: Int) → String  n 字节安全随机数的十六进制(2n 字符)
def token_hex(n: Int) -> String
    requires n >= 0
{
    return secrets_token_hex(n);
}

// rand_below(n: Int) → Int  [0, n) 安全随机整数
def rand_below(n: Int) -> Int
    requires n > 0
{
    return secrets_rand_below(n);
}

// choice(lst: List) → Any  列表安全随机取一(空表抛 ValueError)
def choice(lst)
    requires len(lst) > 0
{
    return secrets_choice(lst);
}
